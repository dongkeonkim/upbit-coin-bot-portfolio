# Trade Service Configuration

# Service
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Upbit API (Authentication Required)
UPBIT_API_URL=https://api.upbit.com
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=trade-service
KAFKA_GROUP_ID=trade-service-group
KAFKA_TOPIC_TRADE_SIGNALS=trade.signals
KAFKA_TOPIC_TRADES_COMPLETED=trades.completed

# Trading Mode
REAL_MODE=false
