# Trading System Environment Variables
# Copy this file to .env.trading and fill in your values

# ==========================================
# Upbit API Credentials (REQUIRED)
# ==========================================
# Get your API keys from: https://upbit.com/mypage/open_api_management
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=

# ==========================================
# Trading Mode (SAFETY SETTINGS)
# ==========================================
# WARNING: Only set to true after thorough testing!
REAL_MODE=false

# ==========================================
# User Configuration
# ==========================================
USER_ID=default_user

# ==========================================
# Monitoring & Alerting
# ==========================================
# Slack webhook URL for Prometheus alerts
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
